// Measures when each word is spoken in public/twoclocks/n*.wav (ElevenLabs forced alignment) and writes
// src/TwoClocks/align.ts, so animations can be cued to the real voice. Re-run after changing the narration.
// The key is read from ELEVENLABS_API_KEY and never printed.
// Usage: npx tsx --env-file=.env scripts/align-narration.mts
import { readFileSync, writeFileSync } from "node:fs";
import { TEXT } from "../src/TwoClocks/timing";

const key = process.env.ELEVENLABS_API_KEY;
if (!key) throw new Error("ELEVENLABS_API_KEY is not set. Run with: npx tsx --env-file=.env scripts/align-narration.mts");

const out: { text: string; start: number }[][] = [];
for (let i = 0; i < TEXT.length; i++) {
  const form = new FormData();
  form.append("file", new Blob([readFileSync(`public/twoclocks/n${i + 1}.wav`)], { type: "audio/wav" }), `n${i + 1}.wav`);
  form.append("text", TEXT[i]);
  const res = await fetch("https://api.elevenlabs.io/v1/forced-alignment", { method: "POST", headers: { "xi-api-key": key }, body: form });
  if (!res.ok) throw new Error(`scene ${i + 1}: ${res.status} ${(await res.text()).slice(0, 200)}`);
  const json = (await res.json()) as { words: { text: string; start: number; end: number }[] };
  const words = json.words.filter((w) => w.text.trim() !== "");
  const expected = TEXT[i].split(/\s+/).length;
  if (words.length !== expected) console.warn(`scene ${i + 1}: ${words.length} aligned words, ${expected} in text`);
  out.push(words.map((w) => ({ text: w.text.trim(), start: Math.round(w.start * 100) / 100 })));
  console.log(`scene ${i + 1} ok (${words.length} words)`);
}
writeFileSync(
  "src/TwoClocks/align.ts",
  `// Generated by scripts/align-narration.mts: when each word starts in the raw narration clips (seconds).\nexport const ALIGN: { text: string; start: number }[][] = ${JSON.stringify(out)};\n`,
);
